{
    "description": "SAPIENT connector configuration for BMS application",
    "note": "Configure connection to SAPIENT Data Fusion Node or run as server for sensor connections",
    "connectors": [
        {
            "id": "sapient-dfn",
            "type": "sapient",
            "enabled": false,
            "config": {
                "mode": "multicast",
                "multicastAddress": "239.192.60.60",
                "multicastPort": 18080,
                "nodeId": "",
                "defaultAffiliation": "unknown",
                "staleTimeout": 300,
                "reconnectInterval": 5,
                "forceUnsetSidcIdentity": true,
                "unsetSidcIdentity": "unknown",
                "classificationSidcMap": {
                    "vehicle": "SUGPUCA--------",
                    "person": "SUGPUCI--------",
                    "drone": "SUAPMHQ--------",
                    "emitter": "SUGPUSM--------"
                },
                "sensorNameSidcMap": {
                    "radar": "10031500002203000000",
                    "lidar": "SFGPUCI--------",
                    "camera": "10031500002201000000",
                    "eo": "SFGP111200-----",
                    "eo_cam": "SFGP111200-----",
                    "acoustic": "10031500002202000000",
                    "acoust": "10031500002202000000",
                    "passive rf": "SFGPUSMV-------",
                    "p_rf": "SFGPUSMV-------"
                }
            }
        },
        {
            "id": "sapient-server",
            "type": "sapient",
            "enabled": false,
            "config": {
                "mode": "server",
                "host": "0.0.0.0",
                "port": 8080,
                "nodeId": "",
                "defaultAffiliation": "unknown",
                "staleTimeout": 300
            }
        }
    ],
    "affiliationMap": {
        "description": "Map sensor classifications to affiliations based on context",
        "rules": [
            {
                "classification": "friendly-vehicle",
                "affiliation": "friend"
            },
            {
                "classification": "hostile-drone",
                "affiliation": "hostile"
            }
        ]
    },
    "notes": {
        "protobufSupport": "Full protobuf parsing requires building with SAPIENT proto files. Without them, the connector operates in simplified mode with limited message parsing.",
        "messageFormat": "SAPIENT messages use a 4-byte network-order length prefix followed by protobuf-encoded SapientMessage (BSI Flex 335 v2.0)",
        "detectionReports": "Detection reports are converted to map symbols based on classification type and default affiliation setting",
        "coordinateSystems": "Supports LAT_LNG_DEG_M coordinates. Range/bearing coordinates require sensor position for conversion."
    }
}