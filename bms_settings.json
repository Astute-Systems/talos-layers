{
    "description": "BMS settings for Millbrook demo — centred on Millbrook Proving Ground (UTAC), Bedford, UK.",
    "location": "millbrook",
    "system": {
        "defaultLatitude": 52.0433,
        "defaultLongitude": -0.5389,
        "fallbackLatitude": 52.0433,
        "fallbackLongitude": -0.5389,
        "defaultZoom": 10,
        "zoneName": "Millbrook / Bedford",
        "callsign": "UTAC"
    },
    "dataLayers": {
        "layersFile": "bms-data-layers.json"
    },
    "routes": {
        "defaultRoute": ""
    },
    "connectors": {
        "json-file": {
            "filePaths": [
                "demo_symbols.json",
                "test_objects.json",
                "uk_adsb_objects.json",
                "uk_ais_objects.json"
            ],
            "watchFile": false,
            "pollInterval": 0
        },
        "gtfs": {
            "sourcesFile": "gtfs_sources.json",
            "enabled": false
        },
        "ais": {
            "configFile": "ais_config.json",
            "enabled": true
        },
        "adsb": {
            "configFile": "adsb_config.json",
            "enabled": true
        },
        "cot": {
            "configFile": "cot_config.json"
        },
        "spx": {
            "configFile": "spx_config.json"
        },
        "sapient": {
            "configFile": "sapient_config.json"
        }
    }
}
